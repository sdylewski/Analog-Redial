# Override some defaults so BT stack is enabled and
# Classic BT is enabled
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y

# vHCI audio datapath (not the default PCM) -- delivers audio as raw
# samples to our own application code via Bluedroid callbacks, instead of
# expecting an external codec wired to a synchronous PCM interface. This is
# the one that lets us bridge to the internal DAC/ADC (GPIO25/26/34) to
# match archive/BLUETOOTH_AUDIO_UPGRADE.md's analog-handoff plan, and to
# J7's analog line-out for this specific test -- PCM mode's pins expect a
# digital bitstream, not raw analog voltage, so it wouldn't work with J7
# directly.
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
