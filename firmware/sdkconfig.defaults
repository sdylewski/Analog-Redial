# Defaults for the rotary phone gateway. Run `idf.py set-target esp32c6` first.

CONFIG_IDF_TARGET="esp32c6"

# Console (bring-up REPL over UART)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# FreeRTOS tick at 1 kHz for tight telephony timing
CONFIG_FREERTOS_HZ=1000

# Main task stack (app_main wires up a lot)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Reasonable log default
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Raise the compile ceiling so ESP_LOGD (debug) isn't stripped -- lets the
# runtime log level (logctl, web UI/console) reach DEBUG for pulse/hook timing.
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Filesystem partition for audio assets (later milestones)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 4 MB flash to fit factory app + asset storage partition
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Default (512) is too small for a real browser POST: modern Chrome/Safari
# add Origin, Sec-Fetch-*, Sec-Ch-Ua, and a long User-Agent, which alone can
# exceed 512 bytes and trip HTTPD_431_REQ_HDR_FIELDS_TOO_LARGE ("Header
# fields too long") on form submits like /voip_set.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1536

# Default is 8.3 short names only (LFN_NONE) -- silently rejects any longer
# filename (fopen() fails, no useful errno). That includes this project's own
# real filenames: recorder.c's rec_l0_20260818_120000Z.wav-style timestamps,
# and prompts like record_prompt.wav -- both well over 8.3. Heap (not stack)
# so it doesn't add to every task's fixed stack for a rarely-hot-path
# operation; 64 covers STORAGE_MAX_NAME (32) with headroom, not the 255
# default (smaller heap alloc per lookup).
# CONFIG_FATFS_LFN_NONE is not set
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
