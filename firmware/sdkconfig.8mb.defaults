# Layered LAST, after sdkconfig.defaults and the board's own
# sdkconfig.<type>.defaults, for a board fitted with an 8 MB module
# (ESP32-C6-DevKitC-1-N8). Use a separate build directory, e.g.:
#   idf.py -B build.smd4_8mb -D SDKCONFIG="build.smd4_8mb/sdkconfig" \
#     -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.smd4.defaults;sdkconfig.8mb.defaults" \
#     set-target esp32c6
# (flash_board.py in bringup/ does this for you.)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_8mb.csv"

# The storage partition is 2.375 MB here instead of 6 MB. Keep ~0.9 MB of
# it free for prompts, clips and answering-machine greetings; recordings
# get the rest (oldest deleted first). With a microSD card, recordings go
# to the card and this cap doesn't apply.
CONFIG_STORAGE_RECORDING_CAP_BYTES=1572864
