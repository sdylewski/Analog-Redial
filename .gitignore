# macOS
.DS_Store

# Python venv (pypdf datasheet extraction)
.venv-datasheet/
.venv/
venv/

# Claude / local AI
.claude/

# KiCad local / generated
hardware/kicad/**/.history/
PayPhone/**/.history/
PayPhone/**/*.kicad_prl
PayPhone/**/*.lck
# Inkscape/Illustrator dated backups next to a drawing
*.svg.[0-9][0-9][0-9][0-9]_[0-9][0-9]_*.svg
hardware/kicad/**/*-backups/
hardware/kicad/**/_restore_backup_*/
hardware/kicad/**/ERC.txt
hardware/kicad/**/preview.svg
hardware/kicad/**/*.kicad_prl
# Fab exports (the JLCPCB plugin's jlcpcb/ folder, pcbway_production/) are
# tracked on purpose; not the plugin's scratch database, Finder files, the
# stray "<board>.kicad_pcb.zip" a PCBWay export leaves next to the project,
# or the old "Analog Redial 5" files left in v6's export folder.
hardware/kicad/**/jlcpcb/project.db
hardware/kicad/**/.DS_Store
hardware/kicad/**/*.kicad_pcb.zip
hardware/kicad/Analog Redial v6/jlcpcb/production_files/*Redial 5*
hardware/kicad/**/fabrication-toolkit-files/
hardware/kicad/**/*.lck
hardware/kicad/**/tmp*.rpt
# Machine-local plugin state -- absolute paths baked in, not portable across
# machines (confirmed live: a leftover fp-lib-table from outside the repo
# broke library resolution on a fresh checkout). Re-added locally by the
# JLCPCB import plugin/KiCad itself as needed.
hardware/kicad/**/fp-lib-table
hardware/kicad/**/sym-lib-table
hardware/kicad/**/JLCImport.*
# Regenerable 3D exports -- large binaries, re-exported often; source is the
# .kicad_pcb/.kicad_sch, not these. Re-export locally when you need one.
hardware/kicad/**/*.step

# ESP-IDF build artifacts (if built inside tree)
firmware/build/
firmware/build.*/
firmware/sdkconfig.old
# firmware/dependencies.lock IS tracked (since 2026-09-28): it pins the exact
# managed-component versions (mdns, led_strip) so every machine builds the
# same thing -- untracked, each machine resolved its own mdns and the
# tracked sdkconfig churned. Bump with `idf.py update-dependencies`.
# bm64_bridge is its own separate idf.py project (see its main.c) with the
# same build-artifact shape as the main firmware/ tree above
firmware/bm64_bridge/build/
firmware/bm64_bridge/sdkconfig.old
firmware/bm64_bridge/dependencies.lock
firmware/bm64_bridge/managed_components/
# Regenerated fresh every configure by firmware/CMakeLists.txt (a clean
# git-describe, not ESP-IDF's own default which picks up this repo's
# archive/* tags -- see that file's comment)
firmware/version.txt
# Fetched by idf.py from idf_component.yml manifests (like a lockfile
# checkout) -- regenerate with `idf.py reconfigure`, don't commit.
firmware/managed_components/


# Python
__pycache__/
*.py[cod]

# gen_prompt.py output -- generated locally, uploaded to the device, not
# meant to live in the repo (source .mp3/.wav clips live outside this repo)
firmware/bringup/*.wav
firmware/bringup/*.aiff

# Piper TTS voice models -- gen_prompt.py downloads these itself (~60MB
# each), not something to commit
firmware/bringup/piper_voices/
firmware/bringup/kokoro_models/
firmware/bringup/tts_venv/

# IDE
.idea/
.vscode/
*.code-workspace

# Local reports / scratch
rotary_phone_gateway_statistics.rpt

# Reference datasheets -- large, don't change, not worth tracking; kept
# locally on dev machines only
datasheets/

# Microchip's own proprietary BM64 tool/firmware package (isupdate.exe,
# EEPROM_Tool, PIC18 reference source, MBA mobile app installers, ...) and
# vendor datasheets/docs -- same reasoning as datasheets/ above. Our own
# Bluetooth/ research notes (BM64_Analog_Audio_Setup.md, eeprom_write/) are
# NOT under either of these paths and stay tracked. (Directory was BM64/
# until 2026-09-28.)
Bluetooth/DSPK v2.1.5 Package/
Bluetooth/Docs/
# The BM64 carrier board's KiCad project lives outside hardware/kicad/, so
# repeat the KiCad local/generated rules for it
Bluetooth/**/.history/
Bluetooth/**/*-backups/
Bluetooth/**/*.kicad_prl
Bluetooth/**/*.lck
Bluetooth/**/*.step
# Fab exports (jlcpcb/) are tracked so anyone can order a board, minus the
# plugin's cache and the BK3266 files left in the BT401 board's export folder.
Bluetooth/**/jlcpcb/project.db
Bluetooth/**/jlcpcb/**/.DS_Store
Bluetooth/DFR0781_BT401/**/jlcpcb/production_files/*BK3266*
Bluetooth/**/tmp*.rpt
Bluetooth/**/_restore_backup_*/
# BK3266 reference material -- vendor manuals, schematics, the Altium
# footprint library and Windows flashing tools, gathered from third-party
# collections (see BK3266_RESEARCH.md for where each came from). Same
# reasoning as datasheets/ and Bluetooth/Docs/ above: large, unlicensed
# vendor documents, kept on dev machines rather than republished here. The
# research write-up that indexes them is the one thing that stays tracked.
Bluetooth/BK3266/**
!Bluetooth/BK3266/BK3266_RESEARCH.md

# DMS serial captures -- large binary blobs, keep locally only
*.dmslog8

# Secrets — never commit
.env
*.pem
credentials.json

# Generated spoken prompts (firmware/bringup/gen_prompt.py)
voice_prompts/**/*.wav
firmware/release/out/
node_modules/
Bluetooth/BM64/DSPK v2.1.5 Package/
