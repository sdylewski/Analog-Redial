# Override some defaults so BT stack is enabled and
# Classic BT is enabled and BT_DRAM_RELEASE is disabled
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_DAC_DMA_AUTO_16BIT_ALIGN=n

# Internal DAC output (GPIO25/26) -- matches this project's documented
# analog-handoff plan (archive/BLUETOOTH_AUDIO_UPGRADE.md): no external
# codec needed for this first bring-up test, and these are the same pins
# the real companion firmware will eventually feed into the main board's
# existing ES8388 analog path. 8-bit resolution on these pins either way --
# this test is exactly how to judge whether that's good enough before
# committing to this chip over BM64.
CONFIG_EXAMPLE_A2DP_SINK_OUTPUT_INTERNAL_DAC=y
