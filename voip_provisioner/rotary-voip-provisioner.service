[Unit]
Description=Rotary phone VoIP provisioner (ESP32 -> FreePBX extension creation)
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=scott
WorkingDirectory=/home/scott/docker/freepbx/voip_provisioner
ExecStart=/usr/bin/python3 /home/scott/docker/freepbx/voip_provisioner/provisioner.py \
    --password-file /home/scott/docker/freepbx/voip_provisioner/setup_password.txt \
    --container freepbx-freepbx-1 \
    --port 8088
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/scott/docker/freepbx/voip_provisioner

[Install]
WantedBy=multi-user.target
