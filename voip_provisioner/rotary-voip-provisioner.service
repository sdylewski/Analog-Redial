[Unit]
Description=Rotary phone VoIP provisioner (ESP32 -> native Asterisk extension creation)
After=asterisk.service
Requires=asterisk.service

[Service]
Type=simple
# Must run as the `asterisk` system user: it owns /etc/asterisk/*.conf
# (mode 644, owner-write-only) and is the only account that can reach
# /var/run/asterisk/asterisk.ctl for `asterisk -rx` reloads.
User=asterisk
Group=asterisk
# No WorkingDirectory: ExecStart is all absolute paths.
# Deployed under /opt, not /home/scott -- home directories are typically
# 750 owner-only, which the `asterisk` user can't traverse at all (this
# previously failed with 200/CHDIR even after WorkingDirectory was removed,
# because open()ing the absolute paths below still walks through
# /home/scott first).
ExecStart=/usr/bin/python3 /opt/rotary-voip-provisioner/provisioner.py \
    --password-file /opt/rotary-voip-provisioner/setup_password.txt \
    --port 8088
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
